# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to a public repository.

# Port the server listens on (most hosts set this for you automatically)
PORT=4000

# Secret key that protects the admin "view orders" endpoint.
# Pick a long random string — this is effectively your admin password.
ADMIN_KEY=12345678FK

# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the URL(s) where your storefront (index.html) is hosted.
# Example: https://mystore.com,https://www.mystore.com
ALLOWED_ORIGINS=*

# Optional: only needed if you've attached a persistent disk (see
# server/README.md). Points the database at the disk's mount path so
# your orders survive redeploys.
# DB_PATH=/var/data/orders.db
